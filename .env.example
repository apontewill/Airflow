# Copy this file to .env, then generate the two secret values as documented.
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# Create a WeatherAPI key at https://www.weatherapi.com/
WEATHER_API_KEY=

# Change these local quick-start credentials before sharing the deployment.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
